{
  "name": "@item-systems/item",
  "version": "0.6.1",
  "description": "A package for interfacing with Non-Fungible Items",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:mobile",
    "test:unit": "ts-mocha \"tests/smartcard/**/*.spec.ts\" \"tests/item/**/*.spec.ts\"",
    "test:mobile": "node --test tests/mobile/mobile.test.mjs",
    "test:integration": "ts-mocha \"tests/integration/**/*.spec.ts\"",
    "test:manual": "ts-mocha \"tests/manual/**/*.spec.ts\"",
    "test:all": "npm run test:unit && npm run test:mobile && npm run test:integration && npm run test:manual",
    "tsc": "npm run clean && tsc -p tsconfig.json && node ./scripts/normalize-esm-specifiers.mjs && tsc -p tsconfig-cjs.json && node ./scripts/rename-cjs-extension.mjs && node ./scripts/normalize-cjs-specifiers.mjs && node ./scripts/normalize-dts-specifiers.mjs",
    "prepublishOnly": "npm run tsc && npm run smoke:packed",
    "clean": "rm -rf ./dist",
    "lint": "eslint --fix .",
    "docs": "typedoc",
    "format": "prettier --write .",
    "smoke:packed": "node ./scripts/smoke-packed-consumer.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/item-systems/item-sdk-typescript.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://item.systems",
  "author": {
    "name": "ITEM Systems",
    "url": "https://item.systems"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@cityofzion/neon-core": "^5.0.0-next.16",
    "@cityofzion/neon-dappkit": "1.0.0",
    "@cityofzion/neon-dappkit-types": "1.0.0",
    "@cityofzion/neon-js": "^5.3.0",
    "@noble/ciphers": "^0.5.3",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "2.0.0",
    "@types/node": "22.18.8",
    "axios": "1.12.2"
  },
  "optionalDependencies": {
    "pcsc-mini": "^0.1.3"
  },
  "devDependencies": {
    "@types/chai": "5.2.2",
    "@types/expect": "^24.3.0",
    "@types/mocha": "^9.1.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "chai": "^6.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "esm": "^3.2.25",
    "mocha": "^11.7.4",
    "prettier": "3.6.2",
    "source-map-support": "^0.5.21",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.28.13",
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.js"
    },
    "./mobile": {
      "types": "./dist/esm/smartcard/mobile/index.d.ts",
      "react-native": "./dist/esm/smartcard/mobile/index.js",
      "import": "./dist/esm/smartcard/mobile/index.js",
      "require": "./dist/cjs/smartcard/mobile/index.cjs"
    },
    "./globalplatform": {
      "types": "./dist/esm/smartcard/globalplatform/index.d.ts",
      "import": "./dist/esm/smartcard/globalplatform/index.js",
      "require": "./dist/cjs/smartcard/globalplatform/index.cjs",
      "default": "./dist/esm/smartcard/globalplatform/index.js"
    },
    "./smartcard": {
      "types": "./dist/esm/smartcard/index.d.ts",
      "import": "./dist/esm/smartcard/index.js",
      "require": "./dist/cjs/smartcard/index.cjs",
      "default": "./dist/esm/smartcard/index.js"
    }
  }
}
